{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartRKAS",
  "version": "0.6.3",
  "identifier": "id.smartrkas.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../app": "./app/",
      "../bootstrap": "./bootstrap/",
      "../config": "./config/",
      "../database": "./database/",
      "../public": "./public/",
      "../resources": "./resources/",
      "../routes": "./routes/",
      "../storage": "./storage/",
      "../vendor": "./vendor/",
      "../artisan": "./artisan",
      "../composer.json": "./composer.json",
      "../composer.lock": "./composer.lock",
      "../.env": "./.env",
      "php": "./php/"
    },
    "createUpdaterArtifacts": false
  }
}
